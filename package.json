{
  "name": "linear-dashboard",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm exec nuxt build",
    "dev": "pnpm exec nuxt dev",
    "generate": "pnpm exec nuxt generate",
    "preview": "pnpm run build && pnpm exec wrangler dev",
    "postinstall": "pnpm exec nuxt prepare",
    "deploy": "pnpm run build && pnpm exec wrangler deploy",
    "cf-typegen": "pnpm exec wrangler types",
    "prepare": "pnpm exec skilld prepare || true"
  },
  "dependencies": {
    "@catppuccin/palette": "^1.8.0",
    "@linear/sdk": "^84.0.0",
    "nuxt": "^4.5.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.5",
    "nitro-cloudflare-dev": "^0.2.2",
    "nitropack": "^2.13.4",
    "skilld": "^2.3.0",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.129.0"
  }
}
